{
  // Cloudflare Workers configuration for src/adapters/worker.ts.
  // Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
  "name": "cf-app-v2",
  "main": "src/adapters/worker.ts",
  "compatibility_date": "2026-09-01",

  // Static files from ./public, read by the app through the ASSETS binding.
  // run_worker_first routes every request through the app, so static files
  // get the same security headers, rate limiting and path checks.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },

  // User records. No database_id on purpose: `wrangler deploy` (4.45+) links the
  // existing database with this name, or creates it on the first deploy. The
  // users table is created on first use (see src/adapters/worker.ts).
  "d1_databases": [
    { "binding": "DB", "database_name": "cf-app-v2" }
  ],

  // Non-secret config. Set secrets with: npx wrangler@4 secret put ADMIN_TOKEN
  "vars": {
    "LOG_LEVEL": "info",
    "CORS_ORIGINS": ""
  },

  "observability": { "enabled": true }
}
