# Configuration reference. Every value is validated at startup; blank values
# mean "use the default". Secrets are never logged.
#
# Export these in your shell, or copy this file to .env and load it:
#   Bun      loads .env automatically
#   Deno     deno run --env-file ... (or export before `deno task start`)
#   Node     node --env-file=.env src/adapters/node.ts
#   Workers  put local values in .dev.vars; use `vars` / `wrangler secret put` when deployed

# Network (Deno, Bun and Node only; Workers ignore these)
PORT=8000
HOST=127.0.0.1

# debug | info | warn | error. Per-request logs are emitted at debug.
LOG_LEVEL=info

# Comma-separated exact origins allowed cross-origin access. "*" is rejected.
# The app's own origin is always allowed.
CORS_ORIGINS=
CORS_ALLOW_CREDENTIALS=false

# Honor X-Forwarded-For / X-Forwarded-Proto. Enable only behind exactly one trusted proxy.
TRUST_PROXY=false

MAX_BODY_BYTES=16384
REQUEST_TIMEOUT_MS=10000
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
SSE_HEARTBEAT_MS=15000

# Bearer token for DELETE /users/:id (at least 32 characters). Unset: always 401.
# Generate one with: openssl rand -base64 32
ADMIN_TOKEN=
